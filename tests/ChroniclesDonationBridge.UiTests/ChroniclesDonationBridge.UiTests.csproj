<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
    <ProjectReference Include="..\..\src\ChroniclesDonationBridge.App\ChroniclesDonationBridge.App.csproj" />
    <Content Include="..\..\src\ChroniclesDonationBridge.App\App.xaml" Link="App.resources-source.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
