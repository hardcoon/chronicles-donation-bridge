<Window x:Class="ChroniclesDonationBridge.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — Chronicles Donation Bridge Beta"
        Width="820" Height="700" MinWidth="700" MinHeight="590"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="17" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}" Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="НАСТРОЙКИ" Style="{StaticResource EyebrowTextStyle}" />
                <TextBlock Text="Подключения и поведение программы" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" BorderThickness="0" Padding="0">
            <TabItem Header="Игра и редактор">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="1,2,8,2">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Папка игры" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Укажите корневую папку Chronicles of Pripyat IX-Ray. Одна кнопка установит или обновит игровой аддон и все файловые шаблоны."
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,13" />
                                <TextBlock Text="ПУТЬ К ИГРЕ" Style="{StaticResource FieldLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding GamePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Выбрать папку…" Click="BrowseGame_Click" Margin="8,0,0,0" />
                                    <Button Grid.Column="2" Content="Установить / обновить всё"
                                            Click="InstallPackage_Click" IsEnabled="{Binding CanInstallBridge}"
                                            Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="14,8"
                                            ToolTip="Установить или обновить игровой аддон и все шаблоны" />
                                </Grid>
                                <TextBlock Text="{Binding InstallationStatus}" Foreground="{DynamicResource SubtleBrush}"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,9,0,0" />
                                <Border Background="{DynamicResource InfoPanelBrush}" CornerRadius="6" Padding="10,7" Margin="0,10,0,0">
                                    <TextBlock Text="Обновляются только известные файлы поставки; перед заменой создаются резервные копии, посторонние Lua-файлы не затрагиваются."
                                               Foreground="{DynamicResource BlueBrush}" TextWrapping="Wrap" FontSize="11" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Редактор Lua-кода" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Кнопка «Открыть код» в карточке эффекта будет использовать выбранную программу."
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,13" />
                                <TextBlock Text="ПУТЬ К РЕДАКТОРУ" Style="{StaticResource FieldLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding EditorPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="Выбрать EXE…" Click="BrowseEditor_Click" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Text="После любого изменения Lua полностью перезапустите игру."
                                           Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="SemiBold" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="DonationAlerts">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="1,2,8,2">
                        <Border Background="{DynamicResource WarningPanelBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource WarningBadgeBrush}" Margin="0,0,11,0">
                                    <TextBlock Text="1" Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Создайте собственное OAuth-приложение" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Авторизация привязывает программу к вашему аккаунту официальным способом. Браузер открывается только по кнопке ниже."
                                               Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" Margin="0,3,0,9" />
                                    <WrapPanel>
                                        <Button Content="Открыть OAuth-приложения" HorizontalAlignment="Left"
                                                Style="{StaticResource PrimaryButtonStyle}" Click="OpenApplications_Click"
                                                Margin="0,0,8,0" />
                                        <Button Content="Официальная документация API" HorizontalAlignment="Left"
                                                Click="OpenApiDocumentation_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Адрес возврата и разрешения" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Скопируйте callback URL в настройки приложения без изменений."
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,13" />
                                <TextBlock Text="CALLBACK URL" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding RedirectUri, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,11" />
                                <TextBlock Text="РАЗРЕШЕНИЯ" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding Scopes, Mode=OneWay}" IsReadOnly="True" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource GoodDarkBrush}" Margin="0,0,11,0">
                                        <TextBlock Text="2" Foreground="{DynamicResource GoodBrush}" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Реквизиты и аккаунт" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Секрет хранится только локально и шифруется средствами Windows."
                                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="Transparent" BorderThickness="0"
                                        Padding="0" Margin="0,0,0,13">
                                    <StackPanel>
                                        <TextBlock Text="ЧТО ВПИСАТЬ" Foreground="{DynamicResource BlueBrush}"
                                                   FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5" />
                                        <TextBlock Foreground="{DynamicResource InfoTextBrush}" TextWrapping="Wrap" FontSize="12">
                                            <Run Text="1. Откройте созданное OAuth-приложение и скопируйте его Client ID и Client Secret." />
                                            <LineBreak />
                                            <Run Text="2. При желании укажите код из своей ссылки после /r/ для проверки аккаунта." />
                                            <LineBreak />
                                            <Run Text="3. Нажмите «Подключить аккаунт» и разрешите доступ на официальном сайте DonationAlerts." />
                                        </TextBlock>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="Открыть OAuth-приложения" Click="OpenApplications_Click"
                                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                                            <Button Content="Документация DonationAlerts API"
                                                    Click="OpenApiDocumentation_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CLIENT ID ПРИЛОЖЕНИЯ" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Client ID созданного OAuth-приложения DonationAlerts" />
                                        <TextBlock Text="ID приложения со страницы OAuth-приложений; обычно это число."
                                                   Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="КОД АККАУНТА (НЕОБЯЗАТЕЛЬНО)" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding ExpectedAccountCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Например, для ссылки /r/my_channel укажите my_channel" />
                                        <TextBlock Text="Код берётся из ссылки /r/ваш_код. Пусто — принять аккаунт после OAuth без дополнительной проверки."
                                                   Foreground="{DynamicResource AccentForegroundBrush}" FontSize="11"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="CLIENT SECRET ПРИЛОЖЕНИЯ" Style="{StaticResource FieldLabelStyle}" Margin="0,13,0,5" />
                                <PasswordBox x:Name="ClientSecretBox"
                                             ToolTip="Client Secret созданного OAuth-приложения DonationAlerts" />
                                <TextBlock Text="Скопируйте секрет из того же OAuth-приложения. Никому его не показывайте."
                                           Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding SecretHint, Mode=OneWay}" Foreground="{DynamicResource SubtleBrush}"
                                           FontSize="11" Margin="0,5,0,13" />

                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="11,8" Margin="0,0,0,11">
                                    <TextBlock Text="{Binding AccountLabel, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Border>

                                <WrapPanel>
                                    <Button Content="Подключить аккаунт" Style="{StaticResource SuccessButtonStyle}"
                                            Click="Connect_Click"
                                            IsEnabled="{Binding Busy, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                                            Margin="0,0,7,0" />
                                    <Button Content="Отключить аккаунт" Click="Disconnect_Click" Margin="0,0,7,0" />
                                    <Button Content="Забыть приложение и секрет" Style="{StaticResource DangerButtonStyle}" Click="Forget_Click" />
                                </WrapPanel>
                                <TextBlock Text="Предварительно нажимать «Сохранить» не нужно. Ни видео, ни звук программа не запускает: системный браузер откроется только после нажатия «Подключить аккаунт»."
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="Защита DonationAlerts API" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Не чаще одного HTTP-запроса в секунду и не более 60 запросов за скользящую минуту. Рекомендуется оставить включённым."
                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="Это НЕ ограничение донатов или игровых эффектов: события донатов приходят по WebSocket без этой задержки."
                                               Foreground="{DynamicResource BlueBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource SwitchCheckBoxStyle}"
                                          IsChecked="{Binding LimitDonationAlertsApiRequests, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="Ограничивать только исходящие HTTP-запросы к DonationAlerts API" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Очередь">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="1,2,8,2">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Гарантированная очередь" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Принятые донаты сохраняются на диск и ждут готовности игры без ограничения по времени. Очередь восстанавливается после перезапуска программы."
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="Если отдельный эффект временно недоступен или находится на собственной паузе, он переносится в конец очереди и не блокирует остальные."
                                           Foreground="{DynamicResource BlueBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Пауза между эффектами" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Защищает игру и эфир от слишком частого выполнения эффектов."
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,13" />
                                <TextBlock Text="ПАУЗА МЕЖДУ ЛЮБЫМИ ЭФФЕКТАМИ, СЕК." Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding GlobalCooldownSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="После любого эффекта следующий не запускается до окончания этой паузы." />
                                <TextBlock Text="Следующий эффект ждёт окончания этой паузы. Значение 0 отключает её."
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource WarningPanelBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="14">
                            <TextBlock Text="Пауза или Alt+Tab не отменяет отправленную команду. В «Истории» кнопка «Обновить события» запрашивает сохранённый ответ без повторного эффекта. Если игра перезапущена или результат неизвестен, событие получает статус «Не подтверждено»."
                                       Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Общие">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="1,2,8,2">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <TextBlock Text="Работа в системном трее" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="При нажатии на крестик окно скрывается, а связь с игрой и DonationAlerts продолжает работать. Полностью завершить программу можно через значок рядом с часами."
                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SwitchCheckBoxStyle}"
                                          IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Правила и действия" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Экспорт включает активные и пользовательские пресеты, их названия, параметры, суммы, очередь и паузы. Секреты и OAuth-токены не экспортируются."
                                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="Экспорт…" Click="Export_Click" Margin="0,0,7,0" />
                                    <Button Content="Импорт…" Click="Import_Click" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Данные программы" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding DataDirectory}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding DataDirectory}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Открыть папку данных" Click="OpenDataDirectory_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="О программе">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="1,2,8,2">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Chronicles Donation Bridge · Beta" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Связывает DonationAlerts с игровыми эффектами Chronicles of Pripyat IX-Ray. Эта сборка в первую очередь ориентирована на мод и его состав аддона."
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding ApplicationVersion, StringFormat=Версия программы: {0}}"
                                           Foreground="{DynamicResource SubtleBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Репозиторий" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Исходный код, документация и актуальные версии программы."
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,7" />
                                <TextBlock>
                                    <Hyperlink NavigateUri="https://github.com/hardcoon/chronicles-donation-bridge"
                                               RequestNavigate="RepositoryLink_RequestNavigate"
                                               Foreground="{DynamicResource AccentForegroundBrush}">github.com/hardcoon/chronicles-donation-bridge</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Поддержать автора" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Карта Т-Банка" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,3" />
                                    <TextBlock Text="2200 3961 2613 9183" FontFamily="Consolas" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentForegroundBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Копировать" Click="CopySupportCard_Click"
                                        VerticalAlignment="Center" Margin="18,0,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource WarningPanelBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                CornerRadius="7" Padding="10,7" Margin="0,11,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status, Mode=OneWay}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource AccentForegroundBrush}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Обычные настройки применяются после сохранения; подключение аккаунта сохраняется сразу."
                       Foreground="{DynamicResource SubtleBrush}"
                       FontSize="11" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Закрыть" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
            <Button Grid.Column="2" Content="Сохранить" Style="{StaticResource PrimaryButtonStyle}"
                    Click="Save_Click" IsDefault="True" MinWidth="110" />
        </Grid>
    </Grid>
</Window>
