<Window x:Class="ChroniclesDonationBridge.App.ActionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка действия — Chronicles Donation Bridge Beta"
        Width="850" SizeToContent="Height" MinWidth="640" MinHeight="330" MaxHeight="780"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="НАСТРОЙКА ДЕЙСТВИЯ" FontSize="11" Foreground="{DynamicResource AccentForegroundBrush}" Margin="0,0,0,7" />
            <TextBlock Text="{Binding Draft.DisplayName}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Draft.Description}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}">
            <ContentPresenter x:Name="EditorContent" Content="{Binding Draft}" Margin="0,0,12,12" />
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,10,0,0">
            <DockPanel IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Отмена" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                    <Button Content="Сохранить и закрыть" Click="Save_Click" IsDefault="True" MinWidth="182" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
                <TextBlock Text="Изменения применятся только после сохранения." Foreground="{DynamicResource SubtleBrush}" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
