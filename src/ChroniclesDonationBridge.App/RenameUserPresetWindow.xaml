<Window x:Class="ChroniclesDonationBridge.App.RenameUserPresetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Название пресета — Chronicles Donation Bridge Beta"
        Width="500" SizeToContent="Height" MinWidth="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="ПОЛЬЗОВАТЕЛЬСКИЙ ПРЕСЕТ" FontSize="11"
                       Foreground="{DynamicResource AccentForegroundBrush}" Margin="0,0,0,7" />
            <TextBlock Text="Изменить название" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Название используется только в программе и сохраняется при экспорте настроек."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Название" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7" />
        <StackPanel Grid.Row="2">
            <TextBox x:Name="NameBox" MaxLength="80" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource BadBrush}"
                       TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" />
        </StackPanel>
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="0,14,0,0" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <Button Content="Сохранить" Click="Save_Click" IsDefault="True"
                        MinWidth="120" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
