<Window x:Class="ChroniclesDonationBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChroniclesDonationBridge.App"
        xmlns:vm="clr-namespace:ChroniclesDonationBridge.App.ViewModels"
        xmlns:core="clr-namespace:ChroniclesDonationBridge.Core;assembly=ChroniclesDonationBridge.Core"
        Title="Chronicles Donation Bridge — Beta"
        Width="1380" Height="860" MinWidth="960" MinHeight="680"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CategoryTabStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="0,0,3,0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                            <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource TriggerChipBrush}" />
                            <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource BlueBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="CategoryTabsTemplate">
            <ListBox ItemsSource="{x:Static vm:ActionBrowserViewModel.Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="0" FontSize="12"
                     ItemContainerStyle="{StaticResource CategoryTabStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Категории действий" ToolTip="Общие случайные пресеты доступны во вкладке «Все».">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </DataTemplate>
        <Style x:Key="GridSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="30" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" Margin="3,0">
                        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" /></ControlTemplate></RepeatButton.Template>
                            </RepeatButton></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Width="16" Height="22" Cursor="SizeWE">
                                <Thumb.Template><ControlTemplate TargetType="Thumb">
                                    <Border Width="14" Height="18" CornerRadius="3" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentTextBrush}" BorderThickness="1" />
                                </ControlTemplate></Thumb.Template>
                            </Thumb></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="{DynamicResource BorderStrongBrush}" VerticalAlignment="Center" /></ControlTemplate></RepeatButton.Template>
                            </RepeatButton></Track.IncreaseRepeatButton>
                        </Track>
                        <Border x:Name="FocusRing" BorderBrush="{DynamicResource BlueBrush}" BorderThickness="1" CornerRadius="3" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="GridDensityTemplate">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Авто" IsChecked="{Binding AutomaticColumns}" VerticalAlignment="Center" Margin="8,0,14,0"
                              ToolTip="Автоматически подбирать число колонок по ширине окна" />
                    <TextBlock Text="{Binding GridLabel}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="1" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    <Slider Minimum="1" Maximum="4" SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding Columns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding AutomaticColumns, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource GridSliderStyle}" Width="120" Margin="6,0" AutomationProperties.Name="Количество колонок"
                            ToolTip="{Binding Columns, StringFormat=Колонок: {0}}" />
                    <TextBlock Text="4" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PresetToolbarTemplate">
            <Grid Margin="0,0,8,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CategoryTabsTemplate}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource GridDensityTemplate}" />
            </Grid>
        </DataTemplate>
        <Style x:Key="HistoryStatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="0,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.Executed}"><Setter Property="Background" Value="{DynamicResource GoodDarkBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource GoodBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.Rejected}"><Setter Property="Background" Value="{DynamicResource BadDarkBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource BadBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.Uncertain}"><Setter Property="Background" Value="{DynamicResource BadDarkBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource BadBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.Expired}"><Setter Property="Background" Value="{DynamicResource BadDarkBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource BadBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.Skipped}"><Setter Property="Background" Value="{DynamicResource WarningPanelBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.NoRule}"><Setter Property="Background" Value="{DynamicResource WarningPanelBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.Deferred}"><Setter Property="Background" Value="{DynamicResource WarningPanelBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.Sent}"><Setter Property="Background" Value="{DynamicResource InfoPanelBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource BlueBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static core:DispatchState.Queued}"><Setter Property="Background" Value="{DynamicResource InfoPanelBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource InfoTextBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <local:HistoryStatusMarkerConverter x:Key="HistoryStatusMarker" />
        <Style x:Key="StatusCardStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="ActionRowCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ActionRowEvenBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ActionRowBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="ClipToBounds" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ActionExpanderHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MainTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="16,10,16,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,5,0" Background="{TemplateBinding Background}">
                            <Border x:Name="SelectionLine" Height="2" CornerRadius="1"
                                    Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Bottom" Visibility="Collapsed" />
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionLine" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                <Setter Property="Background" Value="{DynamicResource TriggerChipBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SelectionLine" Property="Background" Value="{DynamicResource BlueBrush}" />
                                <Setter TargetName="SelectionLine" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainHistoryHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
            <Setter Property="Padding" Value="9,7" />
        </Style>

        <Style x:Key="HistoryQueueRemoveButtonStyle" TargetType="Button"
               BasedOn="{StaticResource DangerButtonStyle}">
            <Setter Property="Content" Value="Удалить из очереди" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="5,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="ToolTip" Value="Отменить событие, пока оно ещё не передано игре" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ParameterTemplate" DataType="{x:Type vm:ParameterValueViewModel}">
            <Grid Margin="0,0,12,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,7" FontSize="12" />
                <StackPanel Grid.Row="1">
                    <Grid>
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChoice, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBoolean, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <CheckBox Content="Включено"
                                  IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBoolean, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <ComboBox ItemsSource="{Binding Options, Mode=OneWay}"
                                  SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource FriendlyValueConverter}}"
                                               Foreground="{DynamicResource TextBrush}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFlatChoice, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGroupedItemChoice, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Категория" Foreground="{DynamicResource SubtleBrush}"
                                           FontSize="10" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding Categories, Mode=OneWay}"
                                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource FriendlyValueConverter}}"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Предмет" Foreground="{DynamicResource SubtleBrush}"
                                           FontSize="10" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding FilteredOptionEntries, Mode=OneWay}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          MaxDropDownHeight="420"
                                          ScrollViewer.CanContentScroll="True"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}"
                                                       ToolTip="{Binding Value}" Foreground="{DynamicResource TextBrush}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding MultiChoiceOptions, Mode=OneWay}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMultiChoice, Mode=OneWay}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MultiChoiceOptionViewModel}">
                                    <CheckBox Content="{Binding Label, Mode=OneWay}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{Binding Value, Mode=OneWay}"
                                              MinWidth="205" Margin="0,2,12,2"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <TextBlock Text="{Binding ValidationMessage, Mode=OneWay}"
                               Foreground="{DynamicResource BadBrush}"
                               FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="PriceChipButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <DataTemplate x:Key="PriceConditionsTemplate">
            <StackPanel Margin="0,9,0,4">
                <ItemsControl ItemsSource="{Binding PriceItems}" ToolTip="Суммы доната: действие запускается при совпадении любого из условий." AutomationProperties.Name="Суммы доната">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type vm:TriggerRuleViewModel}">
                            <Border Background="{DynamicResource TriggerChipBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Label}" Style="{StaticResource PriceChipButtonStyle}"
                                            ToolTip="Изменить только это условие" AutomationProperties.Name="{Binding Label, StringFormat=Изменить условие {0}}"
                                            Command="{Binding DataContext.EditTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <Button Content="×" MinWidth="26" MinHeight="32" Padding="4,4" Style="{StaticResource GhostButtonStyle}"
                                            Foreground="{DynamicResource MutedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1,0,0,0"
                                            ToolTip="Удалить только это условие" AutomationProperties.Name="{Binding Label, StringFormat=Удалить условие {0}}"
                                            Command="{Binding DataContext.DeleteTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ActionViewModel}">
                            <Button Content="+ Сумма" MinHeight="34" Margin="0,0,6,6" Padding="10,5"
                                    Style="{StaticResource AccentOutlineButtonStyle}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                    Command="{Binding DataContext.AddTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ActionEditorTemplate">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Parameters}" ItemTemplate="{StaticResource ParameterTemplate}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRowBundle}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                        <local:ActionCardPanel MinimumColumnWidth="300" MaximumColumns="2" Columns="{Binding EditorParameterColumns}" />
                    </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsItemBundle}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger></Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Предметы в одном срабатывании" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,9" />
                    <ItemsControl ItemsSource="{Binding ItemSpawnRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ItemSpawnRowViewModel}">
                                <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="5" Padding="10,8" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Категория" Foreground="{DynamicResource SubtleBrush}" FontSize="10" Margin="0,0,0,3" />
                                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource FriendlyValueConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Предмет" Foreground="{DynamicResource SubtleBrush}" FontSize="10" Margin="0,0,0,3" />
                                            <ComboBox ItemsSource="{Binding FilteredOptionEntries}" SelectedValuePath="Value"
                                                      SelectedValue="{Binding ItemId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      MaxDropDownHeight="420" VirtualizingStackPanel.IsVirtualizing="True"
                                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" ToolTip="{Binding Value}" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Количество" Foreground="{DynamicResource SubtleBrush}" FontSize="10" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <Button Grid.Column="6" Content="Удалить" VerticalAlignment="Bottom" Padding="10,6"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding DataContext.RemoveItemSpawnCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding ValidationMessage}"
                                                   Foreground="{DynamicResource BadBrush}" FontSize="11" Margin="0,55,0,0" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ Добавить предмет" Command="{Binding AddItemSpawnCommand}"
                            HorizontalAlignment="Left" Padding="12,7" Margin="0,2,0,0"
                            Style="{StaticResource AccentOutlineButtonStyle}" />
                    <TextBlock Text="Все строки выполняются как одно действие и относятся к одной сумме доната."
                               Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsSpawnGroupBundle}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger></Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Состав одного срабатывания" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,9" />
                    <ItemsControl ItemsSource="{Binding SpawnGroupRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SpawnGroupRowViewModel}">
                                <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="5" Padding="10,8" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding VariantDisplayName}" Foreground="{DynamicResource SubtleBrush}" FontSize="10" Margin="0,0,0,3" />
                                            <ComboBox ItemsSource="{Binding VariantOptions}"
                                                      SelectedItem="{Binding VariantId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource FriendlyValueConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Сила" Foreground="{DynamicResource SubtleBrush}" FontSize="10" Margin="0,0,0,3" />
                                            <ComboBox ItemsSource="{Binding StrengthOptions}"
                                                      SelectedItem="{Binding Strength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource FriendlyValueConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Количество" Foreground="{DynamicResource SubtleBrush}" FontSize="10" Margin="0,0,0,3" />
                                            <TextBox Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <Button Grid.Column="6" Content="Удалить" VerticalAlignment="Bottom" Padding="10,6"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding DataContext.RemoveSpawnGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Grid.Column="0" Grid.ColumnSpan="5" Text="{Binding ValidationMessage}"
                                                   Foreground="{DynamicResource BadBrush}" FontSize="11" Margin="0,55,0,0" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ Добавить группу" Command="{Binding AddSpawnGroupCommand}"
                            HorizontalAlignment="Left" Padding="12,7" Margin="0,2,0,0"
                            Style="{StaticResource AccentOutlineButtonStyle}" />
                    <TextBlock Text="Все строки создаются как одно действие и относятся к одной сумме доната."
                               Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="0,7,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding CooldownLabel}" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,7" />
                <TextBox Text="{Binding CooldownText, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding CooldownValidationMessage}" Foreground="{DynamicResource BadBrush}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CooldownHint}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PdaActionCardContentTemplate" DataType="{x:Type vm:ActionViewModel}">
            <StackPanel Margin="14,12,14,10">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="{DynamicResource TriggerChipBrush}" Padding="5,3" Margin="0,0,10,0"
                            VerticalAlignment="Top" Visibility="{Binding IsPreset, Converter={StaticResource InverseBooleanConverter}}">
                        <TextBlock Text="{Binding DisplayOrdinalLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontFamily="Consolas" />
                    </Border>
                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PriceConditionsTemplate}"
                                  Visibility="{Binding IsPreset, Converter={StaticResource InverseBooleanConverter}}" />
                <ItemsControl ItemsSource="{Binding ParameterSummaryItems}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource InfoTextBrush}" TextWrapping="Wrap" Margin="0,0,12,3" />
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding AvailabilityMessage}" Foreground="{DynamicResource BadBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0">
                    <TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers><DataTrigger Binding="{Binding AvailabilityMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding LastResult, StringFormat=Результат: {0}}" ToolTip="{Binding LastResult}"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="0,2,0,0" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,9,0,0" Padding="0,8,0,0">
                    <local:CardToolbarPanel>
                        <Button Content="Настроить" Click="ConfigureAction_Click" Padding="10,5" MinWidth="86" AutomationProperties.Name="Настроить параметры пресета" />
                        <Button Content="✎" Width="34" Padding="0,5" FontSize="17"
                                Style="{StaticResource GhostButtonStyle}"
                                Visibility="{Binding IsUserPreset, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.RenameUserPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="Переименовать пользовательский пресет"
                                ToolTip="Изменить название пользовательского пресета" />
                        <Button Content="Тест" MinWidth="58" Padding="10,5"
                                IsEnabled="{Binding IsAvailable}"
                                Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                ToolTip="Проверить эффект без доната. Если игра не готова, действуют настройки ожидания."
                                Command="{Binding DataContext.TestCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        <Button Content="В активные" MinWidth="100" Padding="10,5" Style="{StaticResource AccentOutlineButtonStyle}"
                                Visibility="{Binding IsUserPreset, Converter={StaticResource BoolToVisibility}}" ToolTip="Создать активный вариант с этими параметрами; сумму можно назначить во вкладке «Активные»"
                                Command="{Binding DataContext.AddFromPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        <Button Content="Сохранить предустановку" Padding="10,5"
                                Visibility="{Binding IsBuiltInPreset, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Сохранить настроенный вариант во вкладке «Пользовательские пресеты»"
                                Command="{Binding DataContext.SaveAsUserPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        <Button Content="⋯" Width="34" Padding="0" FontSize="20"
                                Style="{StaticResource GhostButtonStyle}" Click="CardMenu_Click"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Другие действия" ToolTip="Код и удаление">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Открыть код" Command="{Binding PlacementTarget.Tag.CodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="Удалить из активных" Foreground="{DynamicResource BadBrush}"
                                              Visibility="{Binding IsPreset, Converter={StaticResource InverseBooleanConverter}}"
                                              Command="{Binding PlacementTarget.Tag.DeleteActiveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                    <MenuItem Header="Удалить пользовательский пресет" Foreground="{DynamicResource BadBrush}"
                                              Visibility="{Binding IsUserPreset, Converter={StaticResource BoolToVisibility}}"
                                              Command="{Binding PlacementTarget.Tag.DeleteUserPresetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </local:CardToolbarPanel>
                </Border>

            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ActiveActionCardTemplateV2" DataType="{x:Type vm:ActionViewModel}">
            <Border Style="{StaticResource ActionRowCardStyle}">
                <Border BorderBrush="{DynamicResource ActionRowMarkerBrush}" BorderThickness="3,0,0,0">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PdaActionCardContentTemplate}" />
                </Border>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PresetCardTemplateV2" DataType="{x:Type vm:ActionViewModel}">
            <Border Style="{StaticResource ActionRowCardStyle}">
                <Border BorderBrush="{DynamicResource ActionRowMarkerBrush}" BorderThickness="3,0,0,0">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PdaActionCardContentTemplate}" />
                </Border>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}" Margin="26,18,26,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="42" Height="42" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Background="{DynamicResource PanelBrush}" CornerRadius="6" Margin="0,0,12,0">
                <TextBlock Text="DB" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="16"
                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="CHRONICLES DONATION BRIDGE · BETA" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="Интерактивные события для стрима" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ThemeToggleButton"
                        Content="{Binding ThemeButtonText, Mode=OneWay}"
                        Click="ThemeToggle_Click"
                        ToolTip="Переключить тёмную и светлую темы"
                        Padding="14,8" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="Настройки" Click="Settings_Click"
                        Padding="17,8" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource StatusCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}" Margin="0,3,12,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="DONATIONALERTS" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{Binding DonationStatus, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatusCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource BlueBrush}" Margin="0,3,12,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ИГРА" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{Binding GameStatus, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="↻" Width="32" Height="28" Padding="0"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding RefreshPresetsCommand}"
                            ToolTip="Повторно проверить игру и установленные файлы пресетов" />
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource StatusCardStyle}" Background="{DynamicResource SurfaceBrush}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="ОБРАБОТКА ДОНАТОВ" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{Binding ProcessingSummary}" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Armed, Mode=TwoWay}"
                              IsEnabled="{Binding CanArm, Mode=OneWay}"
                              Style="{StaticResource SwitchCheckBoxStyle}"
                              ToolTip="{Binding ArmHint, Mode=OneWay}"
                              VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Style="{StaticResource MainTabItemStyle}">
                <TabItem.Header><StackPanel Orientation="Horizontal">
                    <TextBlock Text="Активные" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                    <Border Background="{DynamicResource CountBadgeBrush}" CornerRadius="2" Padding="6,1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding ActiveActions.Count}" FontSize="10" />
                    </Border>
                </StackPanel></TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <local:CardToolbarPanel Margin="0,0,8,12">
                        <ContentPresenter Content="{Binding ActiveBrowser}" ContentTemplate="{StaticResource CategoryTabsTemplate}" />
                        <Button Content="Сортировать по цене" Command="{Binding SortActiveByPriceCommand}" Style="{StaticResource GhostButtonStyle}" ToolTip="Разовая сортировка по минимальной назначенной сумме, без пересчёта валют." />
                        <ContentPresenter Content="{Binding ActiveBrowser}" ContentTemplate="{StaticResource GridDensityTemplate}" />
                    </local:CardToolbarPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ActiveActionsList" ItemsSource="{Binding ActiveBrowser.VisibleActions}" ItemTemplate="{StaticResource ActiveActionCardTemplateV2}" Margin="0,0,10,8">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                                <local:ActionCardPanel MinimumColumnWidth="380" MaximumColumns="4" Columns="{Binding ActiveBrowser.EffectiveColumns}" />
                            </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style><Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding ActiveBrowser.VisibleActions.IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger></Style.Triggers>
                        </Style></StackPanel.Style>
                        <TextBlock Text="В этой категории пока нет действий" FontSize="17" TextAlignment="Center" />
                        <TextBlock Text="Добавьте вариант из пресетов или выберите «Все»." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Style="{StaticResource MainTabItemStyle}">
                <TabItem.Header><StackPanel Orientation="Horizontal">
                    <TextBlock Text="Пользовательские пресеты" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                    <Border Background="{DynamicResource CountBadgeBrush}" CornerRadius="2" Padding="6,1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding UserPresets.Count}" FontSize="10" />
                    </Border>
                </StackPanel></TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <local:CardToolbarPanel Margin="0,0,8,12">
                        <ContentPresenter Content="{Binding UserPresetBrowser}" ContentTemplate="{StaticResource CategoryTabsTemplate}" />
                        <ContentPresenter Content="{Binding UserPresetBrowser}" ContentTemplate="{StaticResource GridDensityTemplate}" />
                    </local:CardToolbarPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="UserPresetsList" ItemsSource="{Binding UserPresetBrowser.VisibleActions}" ItemTemplate="{StaticResource PresetCardTemplateV2}" Margin="0,0,10,8">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                                <local:ActionCardPanel MinimumColumnWidth="380" MaximumColumns="4" Columns="{Binding UserPresetBrowser.EffectiveColumns}" />
                            </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style><Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding UserPresetBrowser.VisibleActions.IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger></Style.Triggers>
                        </Style></StackPanel.Style>
                        <TextBlock Text="Пользовательских пресетов пока нет" FontSize="17" TextAlignment="Center" />
                        <TextBlock Text="Настройте обычный пресет и нажмите «Сохранить предустановку»." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Style="{StaticResource MainTabItemStyle}">
                <TabItem.Header><StackPanel Orientation="Horizontal">
                    <TextBlock Text="Пресеты" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" />
                    <Border Background="{DynamicResource CountBadgeBrush}" CornerRadius="2" Padding="6,1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Presets.Count}" FontSize="10" />
                    </Border>
                </StackPanel></TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <local:CardToolbarPanel Margin="0,0,8,12">
                        <ContentPresenter Content="{Binding PresetBrowser}" ContentTemplate="{StaticResource CategoryTabsTemplate}" />
                        <ContentPresenter Content="{Binding PresetBrowser}" ContentTemplate="{StaticResource GridDensityTemplate}" />
                    </local:CardToolbarPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="PresetsList" ItemsSource="{Binding PresetBrowser.VisibleActions}" ItemTemplate="{StaticResource PresetCardTemplateV2}" Margin="0,0,10,8">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                                <local:ActionCardPanel MinimumColumnWidth="380" MaximumColumns="4" Columns="{Binding PresetBrowser.EffectiveColumns}" />
                            </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style><Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding PresetBrowser.VisibleActions.IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger></Style.Triggers>
                        </Style></StackPanel.Style>
                        <TextBlock Text="В этой категории пока нет действий" FontSize="17" TextAlignment="Center" />
                        <TextBlock Text="Выберите другую категорию или проверьте путь к аддону." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Style="{StaticResource MainTabItemStyle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="История" Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}" FontWeight="SemiBold" />
                        <Border Background="{DynamicResource CountBadgeBrush}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding History.Count, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontSize="10" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="{DynamicResource ListWellBrush}" BorderThickness="0" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Background="{DynamicResource ListWellBrush}" Height="45">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="13,0" VerticalAlignment="Center">
                                <TextBlock Text="История событий" Style="{StaticResource SectionTitleStyle}" FontSize="15" />
                                <TextBlock Text="  •  последние 500 записей" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Повторить выбранное" Command="{Binding RetryCommand}"
                                    Style="{StaticResource AccentOutlineButtonStyle}"
                                    Margin="0,6,4,6" Padding="12,4"
                                    ToolTip="Повтор доступен только для безопасных завершённых событий" />
                            <Button Content="{Binding RefreshEventsButtonText}" Command="{Binding RefreshEventsCommand}"
                                    Style="{StaticResource AccentOutlineButtonStyle}" Margin="0,6,4,6" Padding="12,4"
                                    ToolTip="Обновить историю и запросить сохранённые ответы игры. Эффекты повторно не запускаются." />
                            <Button x:Name="ClearQueueButton" Content="Очистить очередь" Command="{Binding ClearQueueCommand}"
                                    Style="{StaticResource DangerButtonStyle}" Margin="0,6,8,6" Padding="12,4"
                                    ToolTip="Удалить все ожидающие события. Уже переданная игре команда не отменяется." />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding History, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedHistory, Mode=TwoWay}"
                                      IsReadOnly="True" AlternationCount="2" BorderThickness="0"
                                      Background="Transparent" GridLinesVisibility="None"
                                      ColumnHeaderStyle="{StaticResource MainHistoryHeaderStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ВРЕМЯ" Binding="{Binding DonationCreatedAt, StringFormat=dd.MM HH:mm:ss}" Width="112" />
                                    <DataGridTextColumn Header="ДОНАТЕР" Binding="{Binding Donor}" Width="125" />
                                    <DataGridTextColumn Header="СУММА" Binding="{Binding Amount}" Width="80" />
                                    <DataGridTextColumn Header="ВАЛЮТА" Binding="{Binding Currency}" Width="70" />
                                    <DataGridTextColumn Header="ДЕЙСТВИЕ" Binding="{Binding ActionName}" Width="175" />
                                    <DataGridTemplateColumn Header="СТАТУС" Width="166">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <Border Style="{StaticResource HistoryStatusBadgeStyle}" HorizontalAlignment="Left" ToolTip="{Binding Detail}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding State, Converter={StaticResource HistoryStatusMarker}}" FontWeight="Bold" Width="18" />
                                                    <TextBlock Text="{Binding State, Converter={StaticResource FriendlyValueConverter}}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="ПОДРОБНОСТИ" Binding="{Binding Detail}" Width="*" />
                                    <DataGridTemplateColumn Header="" Width="138">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource HistoryQueueRemoveButtonStyle}"
                                                        Command="{Binding DataContext.RemoveQueuedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=HistoryGrid, Path=HasItems}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Событий пока не было" Foreground="{DynamicResource MutedBrush}"
                                           FontSize="14" HorizontalAlignment="Center" />
                                <TextBlock Text="Тесты эффектов и обработанные донаты появятся здесь."
                                           Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Panel.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                MaxWidth="500" MinHeight="38" Margin="600,0,0,0" Padding="12,7"
                Background="{DynamicResource TriggerChipBrush}" BorderBrush="{DynamicResource WarningBorderBrush}"
                BorderThickness="1" CornerRadius="4" IsHitTestVisible="False"
                AutomationProperties.Name="Таймер следующего эффекта">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NextEffectStatus}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding NextEffectStatus, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
        </Border>

        <Grid Grid.Row="3" Margin="2,8,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Notice, Mode=OneWay}" Foreground="{DynamicResource AccentForegroundBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding DataDirectory, Mode=OneWay}"
                       Foreground="{DynamicResource SubtleBrush}" FontSize="10"
                       TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
