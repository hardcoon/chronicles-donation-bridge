<Window x:Class="ChroniclesDonationBridge.App.TriggerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Условие доната"
        Width="570" MinWidth="520" MinHeight="470" MaxHeight="760"
        SizeToContent="Height"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="TriggerFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="CalculatedPriceChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TriggerChipBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Background="{DynamicResource BackgroundBrush}" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="УСЛОВИЕ ДОНАТА" Style="{StaticResource EyebrowTextStyle}" />
                <TextBlock Text="Когда запускать эффект" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0" />
                <TextBlock Text="Добавьте одну цену или пересчитайте её сразу для всех валют DonationAlerts."
                           Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="18,17">
                <StackPanel>
                    <TextBlock Text="ТИП УСЛОВИЯ" Style="{StaticResource TriggerFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding Comparators, Mode=OneWay}"
                              SelectedItem="{Binding Comparator, Mode=TwoWay}" Margin="0,0,0,17">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource FriendlyValueConverter}}"
                                           Foreground="{DynamicResource TextBrush}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="СУММА" Style="{StaticResource TriggerFieldLabelStyle}" />
                            <TextBox Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ВАЛЮТА" Style="{StaticResource TriggerFieldLabelStyle}" />
                            <ComboBox IsEditable="True" ItemsSource="{Binding Currencies, Mode=OneWay}"
                                      Text="{Binding Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource InfoPanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="12,10" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource BlueBrush}" FontSize="11" FontWeight="SemiBold"
                                       Text="=  Только указанная сумма     ≥  Указанная сумма или больше" />
                            <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11"
                                       Margin="0,5,0,0"
                                       Text="Обычное сохранение добавляет только выбранную валюту. Сопоставление донатов всегда остаётся строгим — конвертации во время доната нет." />
                            <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11"
                                       Margin="0,5,0,0"
                                       Text="Точная сумма важнее порогов ≥. Если точного совпадения нет, срабатывает только самый высокий подходящий порог. Несколько активных действий с одинаковым победившим условием выполняются по очереди." />
                        </StackPanel>
                    </Border>

                    <Separator Margin="0,17,0,15" />

                    <TextBlock Text="АВТОМАТИЧЕСКИЙ РАСЧЁТ" Style="{StaticResource TriggerFieldLabelStyle}" />
                    <Button Content="{Binding CalculateButtonText, Mode=OneWay}"
                            Click="CalculateAll_Click"
                            IsEnabled="{Binding CanCalculate, Mode=OneWay}"
                            Foreground="{DynamicResource AccentForegroundBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            Background="{DynamicResource PanelAltBrush}"
                            HorizontalAlignment="Stretch" MinHeight="40" />
                    <TextBlock Text="Берётся актуальный официальный курс Банка России. При сохранении старые цены этого варианта будут удалены и рассчитаны заново."
                               Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,7,0,0" />

                    <Border Margin="0,14,0,0" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="3" Padding="12,11"
                            Visibility="{Binding HasCalculatedPrices, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="НОВЫЕ ЦЕНЫ" Style="{StaticResource TriggerFieldLabelStyle}" />
                            <ItemsControl ItemsSource="{Binding CalculatedPrices, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CalculatedPriceChipStyle}">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ConversionStatus, Mode=OneWay}"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource BadDarkBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="11,8" Margin="0,11,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Error, Mode=OneWay}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Error, Mode=OneWay}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Error, Mode=OneWay}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="3" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Отмена" IsCancel="True" MinWidth="94" Margin="0,0,9,0" />
                <Button Grid.Column="2" Content="{Binding SaveButtonText, Mode=OneWay}" IsDefault="True" MinWidth="150"
                        Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
